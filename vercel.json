{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "quant/**",
          "app.py",
          "engine.py",
          "market.py",
          "news.py",
          "storage.py",
          "provenance.py",
          "marketintel.py",
          "scanner.py",
          "fundamentals.py",
          "ledger.py",
          "performance.py",
          "riskx.py",
          "strategylab.py",
          "relative.py",
          "pages.py",
          "calendars.py",
          "alertrules.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
